@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&display=swap');

:root {
  font-family: 'DM Sans', 'Segoe UI', sans-serif;
  color: #20324a;
  background: #edf7ff;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  font-optical-sizing: auto;
  font-weight: 400;
  --blue: #3479e5;
  --navy: #172941;
  --muted: #6d8197;
  --orange: #ff9a42;
  --line: #e3edf6;
  --shadow: 0 18px 55px rgba(40, 88, 130, .11);
}

* { box-sizing: border-box; }
body { margin: 0; min-width: 320px; min-height: 100vh; background: #edf7ff; }
button, input { font: inherit; }
button { cursor: pointer; }
button:focus-visible, input:focus-visible { outline: 3px solid rgba(52, 121, 229, .38); outline-offset: 3px; }
.topbar { display: flex; align-items: center; justify-content: space-between; gap: 18px; width: min(1190px, 100%); margin: 0 auto; }
.brand { display: inline-flex; align-items: center; gap: 8px; color: var(--navy); font-family: Outfit, sans-serif; font-size: 15px; font-weight: 800; letter-spacing: .035em; text-decoration: none; }
.brand b { color: var(--blue); }
.brand-icon { display: grid; width: 35px; height: 35px; place-items: center; border-radius: 12px; color: white; font-size: 18px; background: linear-gradient(145deg, #57c8f2, #3977eb); box-shadow: 0 5px 13px #579ee852; }
.player-chip { display: flex; align-items: center; gap: 8px; padding: 8px 13px; border: 1px solid #e3edf5; border-radius: 30px; color: #3d536c; background: #ffffffbd; font-weight: 700; }
h1, h2, h3, p { margin-top: 0; }
.hero-copy h1, .content-heading h1, .content-card h1 { margin: 19px 0 12px; color: var(--navy); font-family: Outfit, 'DM Sans', sans-serif; font-size: clamp(40px, 5.2vw, 68px); font-weight: 800; line-height: 1.06; letter-spacing: -.055em; }
.btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 44px; padding: 11px 18px; border: 0; border-radius: 13px; font-size: 14px; font-weight: 800; transition: transform .18s ease, box-shadow .18s ease, background .18s ease; }
.btn:hover:not(:disabled) { transform: translateY(-2px); }
.btn-primary { color: white; background: linear-gradient(115deg, #4588ef, #316bd9); box-shadow: 0 9px 20px #3479e544; }
.btn-primary:hover { box-shadow: 0 12px 25px #3479e55c; }
.btn-secondary { color: #2d6dc5; border: 1px solid #d4e5f8; background: #f0f7ff; }
.btn-outline { color: #536981; border: 1px solid #d9e7f2; background: #ffffffc9; }
.btn-ghost { min-height: 38px; padding: 8px 13px; color: #63778d; background: transparent; }
.btn-large { min-height: 54px; padding: 14px 20px; border-radius: 15px; }
.app-footer { display: flex; align-items: center; justify-content: space-between; gap: 12px 24px; width: min(1190px, 100%); margin: auto auto 0; padding: 14px 0 2px; border-top: 1px solid #dfeaf4; color: #71869b; font-size: 11px; line-height: 1.5; }
.page-shell > .app-footer { width: min(1190px, 100%); }
.game-screen > .app-footer { z-index: 2; flex: 0 0 auto; width: 100%; margin: 0; padding: 9px clamp(12px, 4vw, 44px); border-top: 1px solid #e3edf5; background: #fffffff2; font-size: 10px; }

.page-shell { display: flex; flex-direction: column; min-height: 100vh; padding: 22px max(5vw, 20px) 30px; background: radial-gradient(ellipse at 80% 10%, #def3ff, transparent 34%), #f3f9ff; }
.content-heading { width: min(1100px, 100%); margin: 53px auto 28px; text-align: center; }.content-heading h1, .content-card h1 { margin: 12px 0; font-size: clamp(34px, 4vw, 48px); letter-spacing: -.04em; }.content-heading p:not(.eyebrow), .lead { color: var(--muted); line-height: 1.7; }

/* =====================================
   LEVEL GRID & LEVEL CARDS
   PHYSICS ADVENTURE SULTRA
===================================== */

.level-grid {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 12px;
  width: min(1100px, 100%);
  margin: 0 auto;
}

.content-heading:has(+ .level-grid) {
  margin: 24px auto 16px;
}

.level-card {
  position: relative;
  display: flex;
  flex-direction: column;
  grid-column: span 2;
  min-width: 0;
  padding: 15px;
  overflow: hidden;
  border: 1px solid #e4edf5;
  border-radius: 23px;
  background: #fff;
  box-shadow: 0 12px 35px #2b638312;
  transition:
    transform .25s ease,
    box-shadow .25s ease,
    border-color .25s ease;
}

/* Posisi kartu keempat dan kelima */
.level-card:nth-child(4) {
  grid-column: 2 / span 2;
}

.level-card:nth-child(5) {
  grid-column: 4 / span 2;
}

/* Garis aksen kartu */
.level-card:before {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 5px;
  content: '';
  background: var(--level-accent);
}

/* Nomor dan status level */
.level-number {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  color: #7d8fa2;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: .1em;
}

.level-number span {
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  padding: 3px 6px;
  border-radius: 20px;
  color: #38ad7f;
  background: #eaf8f1;
  font-size: 8px;
  letter-spacing: .02em;
  white-space: nowrap;
}

/* Ikon level */
.level-icon {
  display: grid;
  width: 50px;
  height: 50px;
  margin: 12px 0 8px;
  place-items: center;
  border: 1px solid color-mix(in srgb, var(--level-accent), white 72%);
  border-radius: 18px;
  background: color-mix(in srgb, var(--level-accent), white 85%);
  box-shadow: 0 7px 17px color-mix(in srgb, var(--level-accent), transparent 88%);
  font-size: 24px;
  transition: transform .25s ease;
}

/* Tipografi */
.level-card h2 {
  margin: 0 0 4px;
  color: #243951;
  font-family: Outfit, sans-serif;
  font-size: 18px;
  line-height: 1.2;
  letter-spacing: -.035em;
}

.level-card h3 {
  margin-bottom: 7px;
  color: var(--level-accent);
  font-size: 11px;
  line-height: 1.35;
}

.level-card p {
  min-height: 0;
  color: #718499;
  font-size: 12px;
  line-height: 1.4;
}

.level-card .level-route {
  min-height: 0;
  margin: 0 0 7px;
  color: #487357;
  font-size: 10px;
  line-height: 1.3;
  font-weight: 800;
  letter-spacing: .04em;
}

/* Tombol */
.btn-level,
.btn-locked {
  width: 100%;
}

.btn-level {
  color: #fff;
  background: var(--level-accent);
}

.btn-locked {
  color: #92a1b0;
  background: #eef2f5;
  cursor: not-allowed;
}

.level-card > button {
  margin-top: auto;
  transition:
    transform .2s ease,
    box-shadow .2s ease,
    filter .2s ease;
}

/* Efek hover */
.level-card:not(.locked):hover {
  transform: translateY(-6px);
  border-color: color-mix(in srgb, var(--level-accent), white 55%);
  box-shadow: 0 20px 42px #2b63831f;
}

.level-card:not(.locked):hover .level-icon {
  transform: translateY(-3px) scale(1.06);
}

.level-card:not(.locked) > button:hover {
  filter: brightness(1.06);
  box-shadow: 0 7px 17px #3479e52b;
}

/* Status terkunci */
.level-card.locked {
  border-color: #e8edf2;
  background: #fbfcfd;
  filter: saturate(.55);
}

.level-card.locked .level-icon {
  box-shadow: none;
}

/* Aksesibilitas */
@media (prefers-reduced-motion: reduce) {
  .level-card,
  .level-icon,
  .level-card > button {
    transition: none;
  }
}

