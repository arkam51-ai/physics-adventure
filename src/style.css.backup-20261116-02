.landing-nav {
  position: absolute;
  z-index: 10;
  top: 0;
  right: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72px;
  padding: max(16px, env(safe-area-inset-top)) clamp(18px, 5vw, 65px) 16px;
  background: linear-gradient(180deg, rgba(8, 23, 40, .68), transparent);
}

.landing-nav .brand {
  color: #fff;
  text-shadow: 0 2px 10px #0008;
}

.landing-nav .brand b {
  color: #71c8ff;
}

.landing-nav .player-chip {
  padding: 7px 10px;
  color: #fff;
  border: 1px solid #ffffff45;
  border-radius: 999px;
  background: #ffffff1c;
  text-shadow: 0 2px 10px #0008;
}

.hero-layout {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  min-height: 100%;
  margin: 0;
}

.hero-art {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  min-height: 100%;
  overflow: hidden;
  border: 0;
  border-radius: 0;
  background: #10243b;
  box-shadow: none;
}

.hero-picture {
  position: absolute;
  z-index: 0;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
}

.hero-image {
  display: block;
  width: 100%;
  height: 100%;
  max-height: none;
  border-radius: 0;
  object-fit: cover;
  object-position: center top;
}

.hero-art::after {
  position: absolute;
  z-index: 1;
  inset: 0;
  content: '';
  pointer-events: none;
  background: linear-gradient(90deg, rgba(7, 20, 36, .5), rgba(7, 20, 36, .12) 58%, transparent);
}

.hero-particles {
  position: absolute;
  z-index: 2;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.hero-copy {
  position: absolute;
  z-index: 4;
  bottom: clamp(82px, 12vh, 132px);
  left: clamp(24px, 8vw, 115px);
  width: min(500px, 44%);
  padding: 0;
  animation: home-copy-enter .9s ease both;
}

.hero-copy .pill {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  padding: 8px 12px;
  color: #d9f1ff;
  border: 1px solid #ffffff45;
  border-radius: 999px;
  background: #071a2e66;
}

.hero-copy .pulse-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #65dfa0;
  box-shadow: 0 0 0 4px #65dfa033;
}

.hero-copy h1 {
  margin: 18px 0 12px;
  color: #fff;
  font-size: clamp(40px, 5.2vw, 68px);
  text-shadow: 0 5px 25px #0008;
}

.hero-copy h1 span {
  color: #72c9ff;
}

.hero-subtitle {
  max-width: 390px;
  margin-bottom: 0;
  color: #e2edf7;
  font-size: 15px;
  line-height: 1.6;
  text-shadow: 0 2px 10px #0008;
}

.hero-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 22px;
}

.hero-buttons .btn {
  min-height: 48px;
  padding: 12px 17px;
  border-radius: 13px;
}

.hero-buttons .btn-primary {
  color: #fff;
  background: linear-gradient(115deg, #269bff, #3867e9);
  box-shadow: 0 9px 24px #258cff52;
  touch-action: manipulation;
  user-select: none;
}

.hero-buttons .btn-outline {
  color: #fff;
  border: 1px solid #ffffff65;
  background: #071a2e66;
}

.hero-buttons .btn:hover {
  transform: translateY(-2px);
}

.hero-buttons .btn-primary:active {
  transform: translateY(1px) scale(.97);
  box-shadow: 0 4px 12px #258cff52;
}

.quick-links {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-top: 19px;
}

.quick-links button {
  padding: 5px 0;
  color: #e4f1ff;
  text-shadow: 0 2px 8px #0008;
  transition: color .2s ease, transform .2s ease;
}

.quick-links button:hover {
  color: #79ceff;
  transform: translateY(-3px);
}

.home-progress {
  display: flex;
  align-items: center;
  gap: 9px;
  width: min(320px, 100%);
  margin-top: 20px;
  padding-top: 12px;
  border-color: #ffffff40;
  color: #d6e5f5;
}

.home-progress strong {
  color: #fff;
}

.home-progress .progress-dot {
  margin-left: auto;
  color: #ffd36a;
  font-size: 18px;
}

.landing > .feature-row {
  position: absolute;
  z-index: 4;
  right: clamp(18px, 5vw, 65px);
  bottom: 18px;
  left: auto;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
  width: min(700px, 52%);
  margin: 0;
}

.landing > .feature-row > div {
  display: grid;
  grid-template-columns: 30px 1fr;
  grid-template-rows: 1fr 1fr;
  align-items: center;
  min-height: 58px;
  padding: 8px 11px;
  border-color: #ffffff30;
  border-radius: 12px;
  background: #071a2e66;
}

.landing > .feature-row > div > span {
  grid-row: span 2;
  font-size: 20px;
}

.landing > .feature-row strong {
  color: #f3f8ff;
  font-size: 10px;
}

.landing > .feature-row small {
  color: #c7d9e9;
  font-size: 10px;
}

/* LAPISAN 1: BERANDA AWAL */
.landing .hero-copy > .pill,
.landing .hero-copy > h1,
.landing .hero-copy > .hero-subtitle,
.landing .hero-copy > .quick-links,
.landing .hero-copy > .home-progress,
.landing .hero-copy .hero-buttons .btn-outline,
.landing > .feature-row,
.landing > .app-footer {
  display: none;
}

.landing .hero-copy .hero-buttons {
  display: block;
  margin: 0;
}

.landing .hero-copy .hero-buttons .btn-primary {
  min-width: 180px;
}

@keyframes home-copy-enter {
  from { opacity: 0; transform: translateY(25px); }
  to { opacity: 1; transform: translateY(0); }
}

.name-input-overlay {
  position: absolute;
  z-index: 20;
  inset: 0;
  display: grid;
  place-items: center;
  padding: 20px;
  background: #071a2e7d;
  backdrop-filter: blur(7px);
  animation: pop-in .24s ease-out;
}

.name-input-card {
  width: min(460px, 100%);
  padding: clamp(24px, 5vw, 38px);
  border: 1px solid #fff;
  border-radius: 24px;
  background: #fff;
  box-shadow: 0 25px 90px #06182e66;
}

.name-input-card h1 {
  margin: 10px 0;
  color: var(--navy);
  font-family: Outfit, sans-serif;
  font-size: clamp(28px, 5vw, 40px);
  line-height: 1.1;
}

.name-input-card > p:not(.eyebrow) {
  color: #718398;
  line-height: 1.6;
}

.name-input-card .btn {
  width: 100%;
  margin-top: 10px;
}

@media (max-width: 900px) {
  .hero-copy {
    bottom: clamp(76px, 11vh, 108px);
    left: 6vw;
    width: min(460px, 48%);
  }

  .hero-copy h1 {
    font-size: clamp(38px, 6vw, 56px);
  }

  .landing > .feature-row {
    right: 6vw;
    width: 40%;
  }
}

@media (max-width: 640px) {
  .landing-nav {
    min-height: 58px;
    padding: max(10px, env(safe-area-inset-top)) 15px 10px;
  }

  .landing-nav .brand {
    max-width: 55%;
    font-size: 10px;
  }

  .landing-nav .player-chip {
    padding: 6px 8px;
    font-size: 10px;
  }

  .hero-copy {
    right: 18px;
    bottom: max(22px, env(safe-area-inset-bottom));
    left: 18px;
    width: auto;
  }

  .hero-image {
    object-fit: cover;
    object-position: center center;
  }

  .hero-copy .pill {
    padding: 7px 11px;
    font-size: 9px;
  }

  .hero-copy h1 {
    margin: 12px 0 8px;
    font-size: clamp(34px, 9vw, 48px);
    line-height: 1.04;
  }

  .hero-subtitle {
    max-width: 300px;
    font-size: 12px;
    line-height: 1.5;
  }

  .hero-buttons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 9px;
    margin-top: 17px;
  }

  .hero-buttons .btn {
    min-height: 47px;
    padding: 10px 8px;
    font-size: 11px;
    border-radius: 12px;
  }

  .quick-links {
    justify-content: space-between;
    gap: 8px;
    margin-top: 15px;
  }

  .quick-links button {
    font-size: 10px;
  }

  .home-progress {
    width: 100%;
    margin-top: 12px;
    padding-top: 9px;
    font-size: 10px;
  }

  .landing > .feature-row {
    position: static;
    grid-template-columns: 1fr;
    width: auto;
    margin: 0 18px max(18px, env(safe-area-inset-bottom));
  }

  .landing > .feature-row > div {
    min-height: 44px;
  }
}

@media (min-width: 641px) and (orientation: portrait) {
  .hero-image {
    object-fit: cover;
    object-position: center top;
  }

  .hero-copy {
    right: 7vw;
    bottom: 8vh;
    left: 7vw;
    width: auto;
    max-width: 520px;
  }

  .landing > .feature-row {
    position: static;
    grid-template-columns: 1fr;
    width: auto;
    margin: 0 7vw 24px;
  }
}

@media (max-width: 640px) and (orientation: portrait) {
  .hero-image {
    object-fit: cover;
    object-position: center center;
  }
}

@media (max-width: 900px) and (orientation: landscape) {
  .hero-image {
    object-fit: cover;
    object-position: center top;
  }
}

@media (orientation: landscape) and (max-height: 500px) {
  .landing-nav {
    min-height: 54px;
    padding-block: 8px;
  }

  .hero-copy {
    bottom: 12px;
    left: 6vw;
    width: min(430px, 48%);
  }

  .hero-copy .pill {
    padding: 5px 9px;
    font-size: 9px;
  }

  .hero-copy h1 {
    margin: 8px 0 5px;
    font-size: clamp(28px, 5vw, 40px);
  }

  .hero-subtitle {
    max-width: 320px;
    font-size: 11px;
  }

  .hero-buttons {
    margin-top: 10px;
  }

  .hero-buttons .btn {
    min-height: 40px;
    padding: 8px 12px;
    font-size: 11px;
  }

  .quick-links {
    margin-top: 8px;
  }

  .quick-links button {
    font-size: 9px;
  }

  .home-progress {
    display: none;
  }

  .landing > .feature-row {
    display: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero-copy,
  .hero-buttons .btn {
    animation: none;
  }
}


/* LAPISAN 2: DASHBOARD JELAJAHI DUNIA GERAK */
.dashboard-screen { display: flex; flex-direction: column; justify-content: center; width: min(1120px, 100%); min-height: 100vh; margin: 0 auto; padding: clamp(24px, 4vh, 50px) max(20px, 5vw) clamp(24px, 3vh, 36px); background: radial-gradient(circle at 90% 0%, #dff4ff, transparent 34%), #f3f9ff; }
.dashboard-header { display: flex; align-items: end; justify-content: space-between; gap: 24px; }
.dashboard-header h1 { margin: 8px 0 9px; color: var(--navy); font-family: Outfit, sans-serif; font-size: clamp(34px, 5vw, 58px); line-height: 1; letter-spacing: -.055em; }
.dashboard-header p:not(.eyebrow) { margin: 0; color: var(--muted); font-size: 15px; }
.dashboard-player { display: grid; flex: 0 0 auto; gap: 5px; min-width: 145px; padding: 14px 17px; border: 1px solid #dceaf4; border-radius: 17px; background: #ffffffb8; text-align: right; }
.dashboard-player span, .dashboard-stats small, .dashboard-route > span { color: #8496a8; font-size: 9px; font-weight: 900; letter-spacing: .12em; }
.dashboard-player strong { color: #2e4964; font-size: 15px; }
.dashboard-menu { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin: clamp(20px, 3vh, 32px) 0 16px; }
.dashboard-menu-button { display: flex; align-items: center; justify-content: center; gap: 9px; min-height: 54px; padding: 12px; border: 1px solid #dce9f3; border-radius: 15px; color: #45627e; background: #ffffffc7; box-shadow: 0 8px 22px #2b63830d; font-size: 11px; font-weight: 900; letter-spacing: .04em; transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease; }
.dashboard-menu-button span { color: var(--blue); font-size: 19px; }
.dashboard-menu-button:hover { transform: translateY(-3px); border-color: #9fc7ec; box-shadow: 0 13px 25px #2b63831c; }
.dashboard-route { display: grid; gap: 7px; padding: clamp(18px, 2.2vh, 24px) 28px; border-radius: 22px; color: white; background: linear-gradient(115deg, #2366b9, #46a7d3); box-shadow: 0 17px 32px #3479e52b; }
.dashboard-route > span { color: #c9edff; }
.dashboard-route strong { font-family: Outfit, sans-serif; font-size: clamp(24px, 4vw, 37px); letter-spacing: -.04em; }
.dashboard-route strong b { color: #a4e7ff; padding: 0 7px; }
.dashboard-route small { color: #d8f3ff; font-size: 12px; }
.dashboard-info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 14px 0; }
.dashboard-info-grid article { display: flex; align-items: start; gap: 14px; padding: 16px 18px; border: 1px solid #e0ebf4; border-radius: 18px; background: white; box-shadow: 0 9px 25px #2b63830d; }
.dashboard-info-grid article > span { color: #ef9a3b; font-size: 27px; }
.dashboard-info-grid strong { color: #354e68; font-size: 12px; letter-spacing: .04em; }
.dashboard-info-grid p { margin: 6px 0 0; color: #7a8da1; font-size: 12px; line-height: 1.55; }
.dashboard-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 16px; }
.dashboard-stats > div { display: grid; gap: 7px; padding: 13px 16px; border: 1px solid #dfeaf3; border-radius: 15px; background: #ffffffb8; }
.dashboard-stats strong { color: #2d679f; font-family: Outfit, sans-serif; font-size: 20px; }
.dashboard-level-button { align-self: center; min-width: 240px; min-height: 56px; font-size: 15px; touch-action: manipulation; }
.dashboard-level-button:active { transform: translateY(1px) scale(.98); }

@media (min-width: 641px) and (max-height: 820px) {
  .dashboard-screen { padding-top: 20px; padding-bottom: 20px; }
  .dashboard-header h1 { font-size: clamp(34px, 4vw, 46px); }
  .dashboard-menu { margin-top: 18px; margin-bottom: 12px; }
  .dashboard-route { padding: 17px 24px; }
  .dashboard-info-grid { gap: 10px; margin: 10px 0; }
  .dashboard-info-grid article { padding: 14px 16px; }
  .dashboard-stats { margin-bottom: 14px; }
  .dashboard-stats > div { padding: 11px 15px; }
}

@media (max-width: 640px) {
  .dashboard-screen { justify-content: flex-start; padding: 20px 16px 18px; }
  .dashboard-header { display: block; }
  .dashboard-header h1 { font-size: clamp(32px, 10vw, 45px); }
  .dashboard-header p:not(.eyebrow) { font-size: 13px; }
  .dashboard-player { width: max-content; margin: 14px 0 0 auto; text-align: right; }
  .dashboard-menu { grid-template-columns: 1fr 1fr; gap: 9px; margin-top: 20px; }
  .dashboard-menu-button { min-height: 49px; font-size: 10px; }
  .dashboard-route { padding: 18px; }
  .dashboard-info-grid { grid-template-columns: 1fr; gap: 9px; margin: 10px 0; }
  .dashboard-info-grid article { padding: 15px 16px; }
  .dashboard-stats { gap: 9px; margin-bottom: 14px; }
  .dashboard-stats > div { padding: 12px 8px; }
  .dashboard-stats small { font-size: 8px; letter-spacing: .05em; }
  .dashboard-stats strong { font-size: 15px; }
  .dashboard-level-button { width: min(100%, 320px); min-width: 0; min-height: 54px; }
}

@media (min-width: 380px) and (max-width: 640px) {
  .dashboard-info-grid { grid-template-columns: 1fr 1fr; gap: 8px; }
  .dashboard-info-grid article { gap: 8px; padding: 12px 10px; }
  .dashboard-info-grid article > span { font-size: 23px; }
  .dashboard-info-grid strong { font-size: 11px; }
  .dashboard-info-grid p { font-size: 11px; line-height: 1.4; }
}

/* =====================================
   PHYSICS ADVENTURE - FINAL HUD LAYOUT
   DESKTOP + MOBILE
===================================== */

/* HUD ROW - DESKTOP */
.hud-row {
  display: grid;
  grid-template-columns: 105px 108px 105px;
  grid-template-rows: 48px 48px;
  justify-content: center;
  align-items: center;
  gap: 9px 8px;
  width: max-content;
  max-width: 100%;
  margin-inline: auto;
}

/* SPEEDOMETER - DESKTOP */
.hud-row > .hud-card:first-child {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  grid-column: 2;
  grid-row: 1 / 3;
  width: 108px;
  height: 108px;
  min-width: 108px;
  padding: 12px;
  box-sizing: border-box;
  border: none;
  border-radius: 50%;
  background: conic-gradient(
    from 225deg,
    #4383e5 0deg 250deg,
    #dce9f7 250deg 270deg,
    transparent 270deg 360deg
  );
  box-shadow:
    0 0 12px #4383e550,
    0 5px 20px #37587230;
}

/* SPEEDOMETER INNER CIRCLE */
.hud-row > .hud-card:first-child::before {
  content: "";
  position: absolute;
  inset: 6px;
  z-index: 0;
  border-radius: 50%;
  background: #ffffff;
}

/* SPEEDOMETER TEXT */
.hud-row > .hud-card:first-child small,
.hud-row > .hud-card:first-child strong {
  position: relative;
  z-index: 1;
}

.hud-row > .hud-card:first-child small {
  color: #8294aa;
  font-size: 8px;
  font-weight: 900;
}

.hud-row > .hud-card:first-child strong {
  color: #3479df;
  font-size: 19px;
  font-weight: 900;
}

/* FOUR INDICATOR POSITIONS */
.hud-row > .hud-card:nth-child(2) {
  grid-column: 1;
  grid-row: 1;
}

.hud-row > .hud-card:nth-child(3) {
  grid-column: 3;
  grid-row: 1;
}

.hud-row > .hud-card:nth-child(4) {
  grid-column: 1;
  grid-row: 2;
}

.hud-row > .hud-card:nth-child(5) {
  grid-column: 3;
  grid-row: 2;
}

/* INDICATOR CARDS */
.hud-row > .hud-card:not(:first-child) {
  display: grid;
  align-content: center;
  justify-items: center;
  gap: 3px;
  width: 100%;
  min-width: 0;
  min-height: 48px;
  padding: 6px 5px;
  box-sizing: border-box;
  border-radius: 11px;
  text-align: center;
}

/* =====================================
   MOBILE PORTRAIT
===================================== */

@media (max-width: 640px) {

    .hud-row {
    display: grid;
    grid-template-columns: 65px 88px 65px;
    grid-template-rows: 40px 40px;
    justify-content: center;
    align-items: center;
    gap: 8px 6px;
    width: max-content;
    max-width: 100%;
    margin-inline: auto;
  }

  /* CENTER SPEEDOMETER */
  .hud-row > .hud-card:first-child {
    grid-column: 2;
    grid-row: 1 / 3;
    width: 88px;
    height: 88px;
    min-width: 88px;
    padding: 9px;
  }

  .hud-row > .hud-card:first-child::before {
    inset: 5px;
  }

  .hud-row > .hud-card:first-child small {
    font-size: 7px;
  }

  .hud-row > .hud-card:first-child strong {
    font-size: 16px;
  }

  /* FOUR COMPACT INDICATORS */
  .hud-row > .hud-card:not(:first-child) {
    width: 100%;
    min-width: 0;
    min-height: 40px;
    padding: 5px 3px;
    border-radius: 9px;
    gap: 2px;
  }

  .hud-row > .hud-card:not(:first-child) small {
    font-size: 7px;
  }

  .hud-row > .hud-card:not(:first-child) strong {
    font-size: 11px;
  }
}
